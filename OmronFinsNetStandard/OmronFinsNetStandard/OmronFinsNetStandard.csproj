<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>

        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>OmronFinsNetStandard</PackageId>
        <PackageVersion>2.0.0</PackageVersion>
        <Authors>volkovskey</Authors>
        <Company>volkovskey</Company>
        <Description>An asynchronous Omron FINS communication library for .NET Standard with connection pooling and thread safety.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/volgor-soft/OmronFinsNetStandard</RepositoryUrl>
        <Tags>Omron FINS PLC Ethernet TCP Automation</Tags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <ApplicationIcon>Icons\icon.ico</ApplicationIcon>

        <AssemblyVersion>2.0.0.0</AssemblyVersion>
        <FileVersion>2.0.0.0</FileVersion>

        <PackageReleaseNotes>
            - Implemented Connection Pooling: Reuses physical TCP connections for better performance.
            - Added Thread Safety: Safe concurrent access from multiple threads.
            - Improved Error Handling: Better distinction between TCP transport errors and FINS protocol errors.
            - Refactored internal architecture while maintaining API compatibility.
        </PackageReleaseNotes>
    </PropertyGroup>

    <ItemGroup>
        <Content Include="Icons\icon.ico"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\README.md">
            <Pack>True</Pack>
            <PackagePath>\</PackagePath>
        </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="NLog" Version="5.3.4"/>
    </ItemGroup>

    <ItemGroup>
        <None Update="nlog.config">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </None>
    </ItemGroup>

</Project>